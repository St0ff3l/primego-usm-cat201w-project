# Copy to .env and replace the example host and credentials with server values.
PRIMEGO_DB_URL=jdbc:mysql://db.example:3306/primego?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
PRIMEGO_DB_USERNAME=change_me
PRIMEGO_DB_PASSWORD=change_me

PRIMEGO_REDIS_HOST=redis.example
PRIMEGO_REDIS_PORT=6379
PRIMEGO_REDIS_PASSWORD=change_me
